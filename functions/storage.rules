// Modified by Viktor Jurczenko, with assistance from Claude (Anthropic) via Claude Code.
// Modified by Neha Chakraborty, with assistance from Claude (Anthropic) via Claude Code.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function circleBucketMember(circleId) {
      let circle = firestore.get(
        /databases/(default)/documents/careCircles/$(circleId)
      );
      return request.auth != null
        && circle.data.storageBucket == bucket
        && request.auth.uid in circle.data.memberIds;
    }

    // Set by deleteAccount: a file added after it looked for the user's files would be left behind.
    // Reads stay allowed, as a failed deletion can leave this set.
    function notBeingDeleted() {
      let profile = firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      );
      return profile.data.get('deletionRequested', false) != true;
    }

    function circleCaregiver(circleId) {
      let profile = firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      );
      return circleBucketMember(circleId)
        && profile.data.role == 'CAREGIVER';
    }

    function validMediaUpload(fileName) {
      return request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && (
          (request.resource.contentType == 'image/jpeg'
            && fileName.matches('.*\\.jpg'))
          || (request.resource.contentType == 'image/png'
            && fileName.matches('.*\\.png'))
          || (request.resource.contentType == 'audio/mp4'
            && fileName.matches('.*\\.m4a'))
        );
    }

    function uploadedByCurrentUser() {
      return request.resource.metadata.authorId == request.auth.uid
        && request.resource.metadata.keys().hasOnly(['authorId']);
    }

    match /careCircles/{circleId}/media/{fileName} {
      allow read: if circleBucketMember(circleId);
      allow create: if circleBucketMember(circleId)
        && notBeingDeleted()
        && validMediaUpload(fileName)
        && uploadedByCurrentUser();
      allow update: if circleBucketMember(circleId)
        && notBeingDeleted()
        && resource.metadata.authorId == request.auth.uid
        && uploadedByCurrentUser()
        && validMediaUpload(fileName);
      // resource is null for a missing file: deleting it is allowed, so a member deleting twice
      // gets "not found", not "permission denied"
      allow delete: if notBeingDeleted()
        && (circleCaregiver(circleId)
          || (circleBucketMember(circleId)
            && (resource == null || resource.metadata.authorId == request.auth.uid)));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
