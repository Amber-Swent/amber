// Written by GitHub Copilot.
// Modified by Viktor Jurczenko, with assistance from Claude (Anthropic) via Claude Code.
// Modified by Neha Chakraborty, with assistance from Claude (Anthropic) via Claude Code.
// Modified by Alaabrine, with assistance from Cursor Agent.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function circleBucketMember(circleId) {
      let circle = firestore.get(
        /databases/(default)/documents/careCircles/$(circleId)
      );
      return request.auth != null
        && circle.data.storageBucket == bucket
        && request.auth.uid in circle.data.memberIds;
    }

    // Set by deleteAccount: a file added after it looked for the user's files would be left behind.
    // Reads stay allowed, as a failed deletion can leave this set. A user without a profile isn't
    // being deleted, as in firestore.rules.
    function notBeingDeleted() {
      let profilePath = /databases/(default)/documents/users/$(request.auth.uid);
      return !firestore.exists(profilePath)
        || firestore.get(profilePath).data.get('deletionRequested', false) != true;
    }

    function circleCaregiver(circleId) {
      let profile = firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      );
      return circleBucketMember(circleId)
        && profile.data.role == 'CAREGIVER';
    }

    function validMediaUpload(fileName) {
      return request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && (
          (request.resource.contentType == 'image/jpeg'
            && fileName.matches('.*\\.jpg'))
          || (request.resource.contentType == 'image/png'
            && fileName.matches('.*\\.png'))
          || (request.resource.contentType == 'audio/mp4'
            && fileName.matches('.*\\.m4a'))
        );
    }

    function validPersonPhotoUpload(fileName) {
      return request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && fileName.matches('[^_]+\\.jpg');
    }

    function uploadedByCurrentUser() {
      return request.resource.metadata.authorId == request.auth.uid
        && request.resource.metadata.keys().hasOnly(['authorId']);
    }

    // Ids must not contain '_': MediaFileCache turns '/' into '_' and relies on ids having none.
    function idsWithoutUnderscore(circleId, personId) {
      return !circleId.matches('.*_.*')
        && !personId.matches('.*_.*');
    }

    function canUploadPersonPhoto(circleId, personId) {
      let circle = firestore.get(
        /databases/(default)/documents/careCircles/$(circleId)
      );
      return personId == request.auth.uid
        || personId in circle.data.people;
    }

    // resource is null for a missing file: deleting it is allowed, so a member deleting twice
    // gets "not found", not "permission denied".
    function canDeleteCircleFile(circleId) {
      return notBeingDeleted()
        && (circleCaregiver(circleId)
          || (circleBucketMember(circleId)
            && (resource == null || resource.metadata.authorId == request.auth.uid)));
    }

    match /careCircles/{circleId}/media/{fileName} {
      allow read: if circleBucketMember(circleId);
      allow create: if circleBucketMember(circleId)
        && notBeingDeleted()
        && validMediaUpload(fileName)
        && uploadedByCurrentUser();
      allow update: if circleBucketMember(circleId)
        && notBeingDeleted()
        && resource.metadata.authorId == request.auth.uid
        && uploadedByCurrentUser()
        && validMediaUpload(fileName);
      allow delete: if canDeleteCircleFile(circleId);
    }

    match /careCircles/{circleId}/people/{personId}/{fileName} {
      allow read: if circleBucketMember(circleId);
      allow create: if circleBucketMember(circleId)
        && notBeingDeleted()
        && idsWithoutUnderscore(circleId, personId)
        && validPersonPhotoUpload(fileName)
        && uploadedByCurrentUser()
        && canUploadPersonPhoto(circleId, personId);
      // A photo path is never reused: caches key by path, so updates are refused.
      allow update: if false;
      allow delete: if canDeleteCircleFile(circleId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
