// Written by Alaabrine, with assistance from
// Cursor (Composer).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function circlePath(circleId) {
      return /databases/$(database)/documents/careCircles/$(circleId);
    }

    function userDoc(uid) {
      return get(userPath(uid)).data;
    }

    function circleDoc(circleId) {
      return get(circlePath(circleId)).data;
    }

    function circleDocAfter(circleId) {
      return getAfter(circlePath(circleId)).data;
    }

    function isMember(circleId) {
      return isSignedIn()
        && exists(circlePath(circleId))
        && request.auth.uid in circleDoc(circleId).memberIds;
    }

    function isCaregiver() {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && userDoc(request.auth.uid).role == 'CAREGIVER';
    }

    // Caregiver role after this batch (onboarding creates profile + circle together).
    function isCaregiverAfter() {
      return isSignedIn()
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.role == 'CAREGIVER';
    }

    function sharesCircleWith() {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && userDoc(request.auth.uid).circleIds.hasAny(resource.data.circleIds);
    }

    function circleIdsOnlyGrew() {
      return request.resource.data.circleIds.hasAll(resource.data.circleIds)
        && request.resource.data.circleIds.size() >= resource.data.circleIds.size();
    }

    // Invite redeem: not yet a member; only arrayUnion(auth.uid), optional patient link.
    function isJoiningCircle() {
      return isSignedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name == resource.data.name
        && request.resource.data.people == resource.data.people
        && request.resource.data.nicknames == resource.data.nicknames
        && request.resource.data.places == resource.data.places
        && (
          request.resource.data.patientId == resource.data.patientId
          || (resource.data.patientId == ''
            && request.resource.data.patientId == request.auth.uid)
        );
    }

    function memberCircleFieldEdit(circleId) {
      return isMember(circleId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.patientId == resource.data.patientId
        && onlyOwnNicknameChanged()
        && placesChangedOnlyByCaregiver();
    }

    function onlyOwnNicknameChanged() {
      return request.resource.data.nicknames == resource.data.nicknames
        || request.resource.data.nicknames.diff(resource.data.nicknames)
             .affectedKeys().hasOnly([request.auth.uid]);
    }

    function placesChangedOnlyByCaregiver() {
      return request.resource.data.places == resource.data.places
        || isCaregiver();
    }

    function mediaStoragePathMatches(circleId) {
      return request.resource.data.storagePath.matches(
        'careCircles/' + circleId + '/.*'
      );
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || sharesCircleWith();

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasAll(['uid', 'role', 'person', 'circleIds'])
        && (
          request.resource.data.circleIds.size() == 0
          || (
            request.resource.data.circleIds.size() == 1
            && request.auth.uid in circleDocAfter(
              request.resource.data.circleIds[0]
            ).memberIds
          )
        );

      allow update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role
        && circleIdsOnlyGrew()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['person', 'circleIds']);

      allow delete: if false;
    }

    match /careCircles/{circleId} {
      allow read: if isMember(circleId);

      allow create: if isSignedIn()
        && (isCaregiver() || isCaregiverAfter())
        && request.resource.data.id == circleId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.patientId == '';

      allow update: if isJoiningCircle() || memberCircleFieldEdit(circleId);

      allow delete: if false;

      match /media/{mediaId} {
        allow read: if isMember(circleId);

        allow create: if isMember(circleId)
          && request.resource.data.id == mediaId
          && request.resource.data.authorId == request.auth.uid
          && mediaStoragePathMatches(circleId);

        allow update: if isMember(circleId)
          && resource.data.authorId == request.auth.uid
          && request.resource.data.id == mediaId
          && request.resource.data.authorId == resource.data.authorId
          && mediaStoragePathMatches(circleId);

        allow delete: if isMember(circleId)
          && resource.data.authorId == request.auth.uid;
      }

      match /stories/{storyId} {
        allow read: if isMember(circleId);

        allow create, update: if isMember(circleId)
          && request.resource.data.id == storyId;

        allow delete: if isMember(circleId);
      }

      match /appointments/{appointmentId} {
        allow read: if isMember(circleId);

        allow create: if isMember(circleId)
          && isCaregiver()
          && request.resource.data.id == appointmentId;

        allow update: if isMember(circleId)
          && isCaregiver()
          && request.resource.data.id == appointmentId;

        allow delete: if isMember(circleId) && isCaregiver();
      }
    }

    match /invitations/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isCaregiver()
        && isMember(request.resource.data.circleId)
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null;

      allow update: if isSignedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.code == resource.data.code
        && request.resource.data.circleId == resource.data.circleId
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['usedBy']);

      allow delete: if false;
    }
  }
}
