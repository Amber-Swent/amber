// Written by Alaabrine, with assistance from
// Cursor (Composer) and GitHub Copilot.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function circlePath(circleId) {
      return /databases/$(database)/documents/careCircles/$(circleId);
    }

    function userDoc(uid) {
      return get(userPath(uid)).data;
    }

    function circleDoc(circleId) {
      return get(circlePath(circleId)).data;
    }

    function circleDocAfter(circleId) {
      return getAfter(circlePath(circleId)).data;
    }

    function isMember(circleId) {
      return isSignedIn()
        && exists(circlePath(circleId))
        && request.auth.uid in circleDoc(circleId).memberIds;
    }

    function isCaregiver() {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && userDoc(request.auth.uid).role == 'CAREGIVER';
    }

    function isCaregiverAfter() {
      return isSignedIn()
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.role == 'CAREGIVER';
    }

    function sharesCircleWith() {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && userDoc(request.auth.uid).circleIds.hasAny(resource.data.circleIds);
    }

    function memberCircleFieldEdit(circleId) {
      return isMember(circleId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['name', 'people', 'nicknames', 'places'])
        && onlyOwnNicknameChanged()
        && placesChangedOnlyByCaregiver();
    }

    function onlyOwnNicknameChanged() {
      return request.resource.data.nicknames == resource.data.nicknames
        || request.resource.data.nicknames.diff(resource.data.nicknames)
        .affectedKeys().hasOnly([request.auth.uid]);
    }

    function placesChangedOnlyByCaregiver() {
      return request.resource.data.places == resource.data.places
        || isCaregiver();
    }

    function mediaStoragePathMatches(circleId) {
      return request.resource.data.storagePath.matches(
          'careCircles/' + circleId + '/media/[^/]+'
      );
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || sharesCircleWith();

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['CAREGIVER', 'PATIENT']
        && request.resource.data.keys()
        .hasOnly(['uid', 'role', 'person', 'circleIds'])
        && (
          request.resource.data.circleIds.size() == 0
          || (
          request.resource.data.circleIds.size() == 1
          && request.auth.uid in circleDocAfter(
            request.resource.data.circleIds[0]
        ).memberIds
        )
        );

      allow update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['person']);

      allow delete: if false;
    }

    match /careCircles/{circleId} {
      allow read: if isMember(circleId);

      allow create: if isSignedIn()
        && (isCaregiver() || isCaregiverAfter())
        && request.resource.data.id == circleId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.patientId == ''
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'patientId', 'memberIds', 'people', 'nicknames',
          'places', 'createdBy', 'createdAt', 'storageBucket'
        ])
        && (
          !('storageBucket' in request.resource.data)
          || request.resource.data.storageBucket == ''
        );

      allow update: if memberCircleFieldEdit(circleId);

      allow delete: if false;

      match /media/{mediaId} {
        allow read: if isMember(circleId);

        allow create: if isMember(circleId)
          && request.resource.data.id == mediaId
          && request.resource.data.authorId == request.auth.uid
          && mediaStoragePathMatches(circleId);

        allow update: if isMember(circleId)
          && resource.data.authorId == request.auth.uid
          && request.resource.data.id == mediaId
          && request.resource.data.authorId == resource.data.authorId
          && mediaStoragePathMatches(circleId);

        allow delete: if isMember(circleId)
          && resource.data.authorId == request.auth.uid;
      }

      match /stories/{storyId} {
        allow read: if isMember(circleId);

        allow create: if isMember(circleId)
          && request.resource.data.id == storyId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'id', 'title', 'description', 'createdBy', 'mediaIds', 'createdAt'
          ]);

        allow update: if isMember(circleId)
          && request.resource.data.id == storyId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasOnly([
            'id', 'title', 'description', 'createdBy', 'mediaIds', 'createdAt'
          ])
          && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['title', 'description', 'mediaIds']);

        allow delete: if isMember(circleId);
      }

      match /appointments/{appointmentId} {
        allow read: if isMember(circleId);

        allow create: if isMember(circleId)
          && isCaregiver()
          && request.resource.data.id == appointmentId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'id', 'title', 'notes', 'startAt', 'durationMinutes', 'location',
            'attendeeIds', 'createdBy', 'createdAt'
          ]);

        allow update: if isMember(circleId)
          && isCaregiver()
          && request.resource.data.id == appointmentId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'title', 'notes', 'startAt', 'durationMinutes', 'location',
            'attendeeIds'
          ]);

        allow delete: if isMember(circleId) && isCaregiver();
      }
    }

    match /invitations/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isCaregiver()
        && isMember(request.resource.data.circleId)
        && request.resource.data.role in ['CAREGIVER', 'PATIENT']
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.keys().hasOnly([
          'code', 'circleId', 'role', 'createdBy', 'createdAt', 'expiresAt', 'usedBy'
        ]);

      // Invitation redemption is performed only by the callable backend.
      allow update: if false;

      allow delete: if false;
    }
  }
}