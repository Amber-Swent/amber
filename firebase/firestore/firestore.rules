// Written by Alaabrine, with assistance from
// Cursor (Composer).
// Modified by Neha Chakraborty and Copilot.
// Modified by Viktor Jurczenko, with assistance from Claude (Anthropic) via Claude Code.
// Modified by Neha Chakraborty, with assistance from Claude (Anthropic) via Claude Code.
// Modified by Alaabrine, with assistance from Cursor (Grok).
// Modified by Yuhan YANG, with assistance from Cursor.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function circlePath(circleId) {
      return /databases/$(database)/documents/careCircles/$(circleId);
    }

    function userDoc(uid) {
      return get(userPath(uid)).data;
    }

    function circleDoc(circleId) {
      return get(circlePath(circleId)).data;
    }

    function circleDocAfter(circleId) {
      return getAfter(circlePath(circleId)).data;
    }

    // Set by deleteAccount, before it looks for what the user has: anything written after that
    // would be left behind. Reads stay allowed, as a failed deletion can leave this set.
    function isBeingDeleted() {
      return exists(userPath(request.auth.uid))
        && userDoc(request.auth.uid).get('deletionRequested', false) == true;
    }

    function isMember(circleId) {
      return isSignedIn()
        && exists(circlePath(circleId))
        // The profile and circle must agree on the family (care-circle) ID.
        && exists(userPath(request.auth.uid))
        && circleId in userDoc(request.auth.uid).circleIds
        && request.auth.uid in circleDoc(circleId).memberIds;
    }

    function canWriteTo(circleId) {
      return isMember(circleId) && !isBeingDeleted();
    }

    function isCaregiver() {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && userDoc(request.auth.uid).role == 'CAREGIVER';
    }

    // Caregiver role after this batch (onboarding creates profile + circle together).
    function isCaregiverAfter() {
      return isSignedIn()
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.role == 'CAREGIVER';
    }

    // Caregiver-only. circleIds may gain exactly one id, including when the user already
    // has circles, and only for a circle this same commit creates for that user.
    function isOwnNewCareCircleLink() {
      let beforeIds = resource.data.circleIds;
      let afterIds = request.resource.data.circleIds;
      let added = afterIds.removeAll(beforeIds);
      return resource.data.role == 'CAREGIVER'
        && afterIds.size() == beforeIds.size() + 1
        && added.size() == 1
        && beforeIds.removeAll(afterIds).size() == 0
        && !exists(circlePath(added[0]))
        && circleDocAfter(added[0]).createdBy == request.auth.uid
        && circleDocAfter(added[0]).memberIds == [request.auth.uid];
    }

    function sharesCircleWith() {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && userDoc(request.auth.uid).circleIds.hasAny(resource.data.circleIds);
    }

    // A personPhotos write changes nothing, or exactly one entry. A missing field counts as {},
    // so adding {} beside a name, people, nicknames, or places edit stays valid.
    function personPhotosChangeIsValid(circleId) {
      let before = resource.data.get('personPhotos', {});
      let after = request.resource.data.get('personPhotos', {});
      return before == after || onePersonPhotoEntryChanged(circleId, before, after);
    }

    // The one changed key is added, replaced, or removed. Removing it is allowed. A kept value
    // must be that key's own photo path; a path copied from another entry has no new value.
    function onePersonPhotoEntryChanged(circleId, before, after) {
      let affected = after.diff(before).affectedKeys();
      let removed = after.diff(before).removedKeys();
      let newValues = after.values().removeAll(before.values());
      return affected.size() == 1
        && personPhotoKeyAllowed(affected)
        && (removed.size() == 1 || personPhotoValueIsOwnPath(circleId, affected, newValues));
    }

    // The changed key is the writer's uid, or a key of people before this write, so a same-write
    // edit of people cannot authorize it. keys() is a List; union() is Set-only, so a people-key
    // removal is allowed when adding the key does not grow that set.
    function personPhotoKeyAllowed(affected) {
      let peopleKeys = resource.data.get('people', {}).keys().toSet();
      return affected.hasOnly([request.auth.uid])
        || peopleKeys.union(affected).size() == peopleKeys.size();
    }

    // The value that stays is a single new string. Copying a path already stored for someone
    // else leaves no new value, and is refused.
    function personPhotoValueIsOwnPath(circleId, affected, newValues) {
      return newValues.size() == 1
        && newValues[0] is string
        && personPhotoPathMatches(circleId, affected, newValues[0]);
    }

    // Ids must not contain '_': MediaFileCache turns '/' into '_' and relies on ids having none.
    function idsWithoutUnderscore(circleId, personId) {
      return !circleId.matches('.*_.*')
        && !personId.matches('.*_.*');
    }

    // careCircles/{circleId}/people/{that key}/{photoId}.jpg, and the folder is the changed key.
    function personPhotoPathMatches(circleId, affected, path) {
      let parts = path.split('/');
      return parts.size() == 5
        && parts[0] == 'careCircles'
        && parts[1] == circleId
        && parts[2] == 'people'
        && parts[4].matches('[^_]+\\.jpg')
        && idsWithoutUnderscore(circleId, parts[3])
        && affected.hasOnly([parts[3]]);
    }

    // Membership / invite redeem is backend-only (Admin SDK / Cloud Functions).
    function memberCircleFieldEdit(circleId) {
      return canWriteTo(circleId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['name', 'people', 'nicknames', 'places', 'personPhotos'])
        && onlyOwnNicknameChanged()
        && placesChangedOnlyByCaregiver()
        && personPhotosChangeIsValid(circleId);
    }

    function onlyOwnNicknameChanged() {
      return request.resource.data.nicknames == resource.data.nicknames
        || request.resource.data.nicknames.diff(resource.data.nicknames)
             .affectedKeys().hasOnly([request.auth.uid]);
    }

    function placesChangedOnlyByCaregiver() {
      return request.resource.data.places == resource.data.places
        || isCaregiver();
    }

    // A text has no file: its storagePath must be empty. Any other media's file is in the
    // circle's media folder.
    function mediaStoragePathMatches(circleId) {
      let isText = request.resource.data.get('type', '') == 'text';
      return (isText && request.resource.data.storagePath == '')
        || (!isText && request.resource.data.storagePath.matches(
          'careCircles/' + circleId + '/media/[^/]+'
        ));
    }

    // What the author may change in a media. Its id, author, file, type, status and creation
    // time never change, so no edit can approve a media or leave its file without a document.
    function onlyEditableMediaFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'description', 'date', 'location', 'shownIds', 'authorizedIds', 'text', 'transcript'
      ]);
    }

    // An appointment as it is stored after a create or an edit: only the fields of Appointment,
    // saved by the signed-in user. It must pass the same checks as validationError() in the app.
    // The attendees must be members of the circle. A field the app can't read would make the
    // appointment disappear for the whole circle, so each one has the type the app expects.
    function isValidAppointment(circleId, appointmentId) {
      let data = request.resource.data;
      return data.id == appointmentId
        && data.keys().hasOnly([
          'id', 'title', 'notes', 'startAt', 'durationMinutes', 'location', 'attendeeIds',
          'lastEndAt', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && data.title is string
        && data.title.trim().size() > 0
        && data.notes is string
        && hasValidAppointmentTime(data)
        && isValidLocation(data.get('location', null))
        && data.updatedBy == request.auth.uid
        && data.updatedAt is int
        && data.attendeeIds is list
        && data.attendeeIds.hasOnly(circleDoc(circleId).memberIds);
    }

    // The start is set, the duration is unknown or between 1 minute and 1 day, and lastEndAt is
    // the end the app computes: the start plus the duration, or plus 60 minutes when it is
    // unknown. The calendar's query trusts lastEndAt, so a wrong one would show the appointment on
    // days it doesn't cover. Repeating appointments will be implemented later, with a lastEndAt at
    // the end of their last occurrence. This check will then have to change.
    function hasValidAppointmentTime(data) {
      let minutes = data.get('durationMinutes', null);
      return data.startAt is int
        && data.startAt > 0
        && data.lastEndAt is int
        && ((minutes == null && data.lastEndAt == data.startAt + 60 * 60000)
          || (minutes is int
            && minutes >= 1
            && minutes <= 24 * 60
            && data.lastEndAt == data.startAt + minutes * 60000));
    }

    // Null, or a GeoLocation: only lat, lng and placeName, each unset or of its type.
    function isValidLocation(location) {
      return location == null
        || (location is map
          && location.keys().hasOnly(['lat', 'lng', 'placeName'])
          && (location.get('lat', null) == null || location.lat is number)
          && (location.get('lng', null) == null || location.lng is number)
          && (location.get('placeName', null) == null || location.placeName is string));
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || sharesCircleWith();

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['CAREGIVER', 'PATIENT']
        && request.resource.data.keys().hasOnly(['uid', 'role', 'person', 'circleIds'])
        && (
          request.resource.data.circleIds.size() == 0
          || (
            request.resource.data.circleIds.size() == 1
            && request.auth.uid in circleDocAfter(
              request.resource.data.circleIds[0]
            ).memberIds
          )
        );

      allow update: if isSelf(uid)
        && !isBeingDeleted()
        && request.resource.data.uid == uid
        && request.resource.data.role in ['CAREGIVER', 'PATIENT']
        && (
          (
            request.resource.data.role == resource.data.role
            && request.resource.data.circleIds == resource.data.circleIds
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['person'])
          )
          || (
            request.resource.data.role == resource.data.role
            && request.resource.data.person == resource.data.person
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['circleIds'])
            && isOwnNewCareCircleLink()
          )
          || (
            // A wrong onboarding role can be corrected until the user joins a circle.
            resource.data.circleIds.size() == 0
            && request.resource.data.circleIds.size() == 0
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['role', 'person'])
          )
        );

      allow delete: if false;
    }

    match /careCircles/{circleId} {
      allow read: if isMember(circleId);

      allow create: if isSignedIn()
        && !isBeingDeleted()
        && (isCaregiver() || isCaregiverAfter())
        && request.resource.data.id == circleId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.patientId == ''
        // the bucket is assigned by the backend only: the app writes it empty
        && request.resource.data.get('storageBucket', '') == ''
        // photos are added after create; a missing or empty map keeps existing creates working
        && request.resource.data.get('personPhotos', {}) == {}
        && request.resource.data.createdAt is int;

      allow update: if memberCircleFieldEdit(circleId);

      allow delete: if false;

      match /media/{mediaId} {
        allow read: if isMember(circleId);

        allow create: if canWriteTo(circleId)
          && request.resource.data.id == mediaId
          && request.resource.data.authorId == request.auth.uid
          && mediaStoragePathMatches(circleId);

        allow update: if canWriteTo(circleId)
          && resource.data.authorId == request.auth.uid
          && onlyEditableMediaFieldsChanged();

        allow delete: if canWriteTo(circleId)
          && resource.data.authorId == request.auth.uid;
      }

      match /stories/{storyId} {
        allow read: if isMember(circleId);

        allow create, update: if canWriteTo(circleId)
          && request.resource.data.id == storyId;

        allow delete: if canWriteTo(circleId);
      }

      match /appointments/{appointmentId} {
        allow read: if isMember(circleId);

        allow create: if canWriteTo(circleId)
          && isValidAppointment(circleId, appointmentId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is int;

        // Every member may edit any appointment, but nobody may change who created it or when
        allow update: if canWriteTo(circleId)
          && isValidAppointment(circleId, appointmentId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if canWriteTo(circleId);
      }
    }

    match /invitations/{code} {
      allow get: if isSignedIn();
      allow list: if isCaregiver()
        && resource.data.createdBy == request.auth.uid
        && isMember(resource.data.circleId);

      allow create: if isCaregiver()
        && canWriteTo(request.resource.data.circleId)
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && !request.resource.data.keys().hasAny(['role'])
        && request.resource.data.usedBy == null;

      // Redeem is backend-only (Admin SDK / Cloud Functions).
      allow update: if false;

      allow delete: if false;
    }
  }
}